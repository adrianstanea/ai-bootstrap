{
  "$comment": "Merged into ~/.claude/settings.json by `ai-bootstrap user`: missing keys are added, existing values (including a plugin you disabled) are kept. @AI_HOOKS@ becomes the absolute path of hooks/bin/ai-hooks.",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(gh pr create)",
      "Bash(gh pr ready *)",
      "Bash(gh pr ready)",
      "Bash(gh pr merge *)",
      "Bash(gh pr merge)",
      "Bash(gh pr edit *)",
      "Bash(gh pr edit)",
      "Bash(gh pr comment *)",
      "Bash(gh pr comment)",
      "Bash(gh pr review *)",
      "Bash(gh pr review)",
      "Bash(gh pr close *)",
      "Bash(gh pr close)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr reopen)",
      "Bash(gh api -X POST repos/*/pulls/*/reviews *)",
      "Bash(gh api --method POST repos/*/pulls/*/reviews *)",
      "Bash(gh api --method=POST repos/*/pulls/*/reviews *)",
      "Bash(gh api graphql --input *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(gh release create *)",
      "Bash(gh release create)",
      "Bash(gh issue create *)",
      "Bash(gh issue create)",
      "Bash(gh issue comment *)",
      "Bash(gh issue comment)",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__create_pull_request_review",
      "mcp__github__add_issue_comment",
      "mcp__github__create_issue",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file"
    ]
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "agent-workflow@adrianstanea": true,
    "ci@adrianstanea": true,
    "dev-practices@adrianstanea": true,
    "diagrams@adrianstanea": true,
    "git-workflow@adrianstanea": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "@AI_HOOKS@ hook SessionStart --emit-invariants",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "@AI_HOOKS@ hook PreToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "@AI_HOOKS@ graphify-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "@AI_HOOKS@ graphify-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
